    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "help": "node build/main.js --help",
        "build": "tsc -p .",
        "dev": "tsc -w -p . --declaration",
        "publish": "npm publish --access public",
        "webpack": "webpack --config webpack.config.js --stats-error-details",
        "exe:win": "cd dist && nexe -i main_node.js -o polymech-cad.exe --build --temp=../../temp-polymech --verbose",
        "installer": "makensis scripts/installer.nsi",
        "test:installer": "dist\\PolyMechCAD-Setup.exe /S /D=C:\\Users\\zx\\Desktop\\polymech\\polymech-mono\\packages\\cad\\dist-out"
    },
    "exports": {
        ".": {
            "import": "./dist-in/index.js",
            "require": "./dist-in/index.cjs"
        }
    },
    "repository": {
        "type": "git",
